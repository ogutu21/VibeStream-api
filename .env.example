PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=vibestream
# Hosted database (e.g. Aiven): turn on encryption and point at the CA file
DB_SSL=false
# DB_SSL_CA_FILE=certs/aiven-ca.pem
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
# Origins only (no path, no trailing slash). Comma-separated.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,https://ogutu21.github.io
